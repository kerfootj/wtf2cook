{
  "name": "wtf2cook-rebuild",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "link-owner": "node --env-file=.env.local --import tsx scripts/link-owner.ts",
    "import:preview": "node --env-file=../.env.local --import tsx scripts/import-preview.ts"
  },
  "dependencies": {
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
